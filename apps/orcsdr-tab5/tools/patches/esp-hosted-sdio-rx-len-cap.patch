@@ -543,6 +543,21 @@ static inline bool sdio_pkt_len_reg_is_bus_fault(uint32_t reg_val)
 	return true;
 }
 
+/* ORCSDR-TAB5 #66: streaming/SW_AGGR used to skip the RX length cap entirely while
+ * host ESP_RX_BUFFER_SIZE stayed 1536. Cap to negotiated E2H (else 15872) so a
+ * garbage PKT_LEN cannot DMA/heap-corrupt under battery timing. */
+static uint32_t sdio_rx_len_cap(void)
+{
+#if EH_HOST_PORT_SDIO_HOST_RX_MODE == EH_HOST_PORT_SDIO_HOST_STREAMING_MODE
+	const struct eh_priv_sdio_buf_config *cfg = eh_host_mcu_transport_sdio_buf_config();
+	if (cfg && cfg->e2h_bufsz_512B)
+		return (uint32_t)cfg->e2h_bufsz_512B * EH_SDIO_CFG_BUF_BLOCK;
+	return 15872u;
+#else
+	return ESP_RX_BUFFER_SIZE;
+#endif
+}
+
 static int sdio_get_len_from_slave(uint32_t *rx_size, uint32_t reg_val, bool is_lock_needed)
 {
 	uint32_t len = reg_val;
@@ -565,13 +580,14 @@ static int sdio_get_len_from_slave(uint32_t *rx_size, uint32_t reg_val, bool is_
 		len = temp + len;
 	}
 
-#if EH_HOST_PORT_SDIO_HOST_RX_MODE != EH_HOST_PORT_SDIO_HOST_STREAMING_MODE
-	if (len > ESP_RX_BUFFER_SIZE) {
-		ESP_LOGE(TAG, "%s: Len from slave[%ld] exceeds max [%d]",
-				__func__, len, ESP_RX_BUFFER_SIZE);
-		return ESP_FAIL;
+	{
+		const uint32_t max_len = sdio_rx_len_cap();
+		if (len > max_len) {
+			ESP_LOGE(TAG, "%s: Len from slave[%ld] exceeds max [%lu]",
+					__func__, len, (unsigned long)max_len);
+			return ESP_FAIL;
+		}
 	}
-#endif
 
 	*rx_size = len;
 
@@ -609,13 +625,14 @@ static int sdio_get_len_from_slave(uint32_t *rx_size, bool is_lock_needed)
 		len = temp + len;
 	}
 
-#if EH_HOST_PORT_SDIO_HOST_RX_MODE != EH_HOST_PORT_SDIO_HOST_STREAMING_MODE
-	if (len > ESP_RX_BUFFER_SIZE) {
-		ESP_LOGE(TAG, "%s: Len from slave[%ld] exceeds max [%d]",
-				__func__, len, ESP_RX_BUFFER_SIZE);
-		return ESP_FAIL;
+	{
+		const uint32_t max_len = sdio_rx_len_cap();
+		if (len > max_len) {
+			ESP_LOGE(TAG, "%s: Len from slave[%ld] exceeds max [%lu]",

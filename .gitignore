# ESP-IDF / PlatformIO
build/
build-native-hosted3/
# A second app build tree, for the stack-usage checks. Only "build/" is matched
# by the bare pattern above; a named sibling has to be listed, or half a
# gigabyte of build output is one `git add -A` away from the history.
build-stackcheck/
.pio/
sdkconfig
sdkconfig.old
dependencies.lock
managed_components/

# The Tab5 native ESP-IDF project pins its component graph for reproducible
# P4/C6 ESP-Hosted pairing.
!apps/orcsdr-tab5/dependencies.lock

# Tooling
dist/
.vscode/
.idea/
__pycache__/
*.user
.DS_Store

# Splash generation outputs (device copies live on microSD).
/docs/OrcSDR_LivingWave*
/docs/OrcSDR_Splash_*_index.csv
/docs/splash/*.csv
/docs/splash/*.jpg
/docs/splash/*.mjpeg
/docs/splash/*.mp4
/docs/splash/*.orsplash
/docs/splash/variants/*/frames/
/docs/splash/variants/*/*.jpg
/docs/splash/variants/*/*.mp4
/docs/splash/variants/*/*.orsplash
Thumbs.db

# Local / secrets
.orclink/
# Shared developer build caches (e.g. the pinned ESP-Hosted C6 image).
.orcsdr-cache/
*.key
*.pem
tmp/
.local/
site/
# Everything under artifacts/ is bench output, written by the tools in tools/ and by the
# screenshot capture. Seven subdirectories used to be listed here one by one, which left
# artifacts/hardware-validation/ and artifacts/screenshots/ tracked by omission - and those
# two hold the Wi-Fi coexistence logs (which record the SSID) and panel captures (which show
# the device's IP in the Home header). This repository is public, so the whole tree is
# ignored rather than named a directory at a time. Nothing here has ever been committed.
artifacts/
docs/user-guide/assets/screenshots/raw/

# Host test run artefacts. tools/sstv_host_tests.sh writes its build and run
# logs, its summary and its decoded PPM frames into the repository root, and
# the SDIO/Wi-Fi host tests configure their own build trees there. Running a
# test should not leave 50 files for the next `git add -A` to pick up.
/sstv-*.log
/sstv-*.ppm
/sstv-*.pgm
# tools/test-sd-storage.sh, added upstream in v0.5.0-beta.1, does the same.
/sd-storage-*.log
/apps/orcsdr-tab5/build-sdio-credit-host/
/apps/orcsdr-tab5/build-wifi-reconnect-host/
